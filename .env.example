# MUST be the same PostgreSQL database for BOTH projects
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

NODE_ENV=development
PORT=3000

# Main app authentication
SESSION_SECRET=replace-with-a-long-random-secret
JWT_SECRET=replace-with-a-long-random-secret
REFRESH_TOKEN_SECRET=replace-with-a-long-random-secret
SESSION_TTL_DAYS=30

# Email (main app)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_APP_PASSWORD=
EMAIL_FROM=

# First super administrator email
ADMIN_EMAILS=

# Public HTTPS URL of the main app
APP_URL=http://localhost:3000

# Private uploads
UPLOAD_MAX_BYTES=4194304
UPLOAD_STORAGE_DIR=private-uploads

# Optional Capacitor wrapper URL. Use the deployed HTTPS URL when generating an APK.
CAPACITOR_SERVER_URL=https://YOUR-MAIN-APP-DOMAIN
